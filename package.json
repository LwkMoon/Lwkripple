{
  "name": "lwkripple",
  "version": "0.1.0",
  "description": "Make any section, button, image or the whole page behave like water. Interactive ripples, zero dependencies.",
  "keywords": [
    "ripple",
    "ripples",
    "water",
    "water-effect",
    "water-ripple",
    "refraction",
    "webgl",
    "webgl2",
    "canvas",
    "interactive",
    "visual-effect",
    "background-effect",
    "react",
    "typescript",
    "zero-dependencies",
    "lwkripple"
  ],
  "license": "MIT",
  "author": {
    "name": "LwkMoon",
    "url": "https://github.com/LwkMoon"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LwkMoon/lwkripple.git"
  },
  "bugs": {
    "url": "https://github.com/LwkMoon/lwkripple/issues"
  },
  "homepage": "https://lwkmoon.github.io/lwkripple/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "dist/react.d.ts"
      ]
    }
  },
  "unpkg": "./dist/lwkripple.global.js",
  "jsdelivr": "./dist/lwkripple.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-demo.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/sim.test.mjs",
    "preview": "node scripts/preview.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
